# JWT and Cookie Environment Variables Example
JWT_ISS=your-issuer
JWT_AUD=your-audience
JWT_AT_TTL=900 # 15 minutes
JWT_RT_TTL=1209600 # 14 days
JWT_KID=your-key-id
JWT_PRIVATE_KEY=your-private-key
JWT_PUBLIC_KEY=your-public-key
COOKIE_DOMAIN=your.domain.com
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
COOKIE_PATH=/
NODE_ENV=development
